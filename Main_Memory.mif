-- Quartus II generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=32;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
	0   :   00011111;
	1   :   10011110;
	2   :   10111101;
	[3..28]  :   00000000;
	29  :   00000001;
	30  :   00000111;
	31  :   00001000;
END;
